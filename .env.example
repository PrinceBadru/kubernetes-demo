# Application Environment & Security
PORT=3000
NODE_ENV=development
API_AUTH_TOKEN=devsecops-demo-api-key
ALLOW_ANONYMOUS_ACCESS=false

# PostgreSQL Persistence Tier
# In production, a secure, non-default password is required (insecure defaults are blocked)
PG_HOST=localhost
PG_PORT=5432
PG_USER=app
PG_PASSWORD=CHANGE_ME_IN_PRODUCTION
PG_DATABASE=auditor
# Optional single-string URI connection:
# DATABASE_URL=postgres://app:CHANGE_ME_IN_PRODUCTION@localhost:5432/auditor

# Redis In-Memory Cache Tier
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

