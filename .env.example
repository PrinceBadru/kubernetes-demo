# Application Environment & Security
PORT=3000
NODE_ENV=development
API_AUTH_TOKEN=your_secure_api_token
ALLOW_ANONYMOUS_ACCESS=false

# PostgreSQL Persistence Tier (Canonical DATABASE_URL or component variables)
# In production, a secure, non-default password is required (known defaults fail closed)
POSTGRES_USER=app
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=auditor
DATABASE_URL=postgres://app:your_secure_postgres_password@localhost:5432/auditor

# Redis In-Memory Cache Tier
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

