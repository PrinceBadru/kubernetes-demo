{
  "name": "devsecops-demo-api",
  "version": "1.0.0",
  "description": "Production-grade DevSecOps Kubernetes demo API service with observability, health probes, and secure defaults",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.js tests/*.test.js tests/metrics.test.js",
    "test:unit": "node --test tests/unit/*.test.js tests/*.test.js tests/metrics.test.js",
    "test:cluster": "bash scripts/test-cluster.sh",
    "validate:catalog": "node scripts/validate-catalog.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrinceBadru/kubernetes-demo.git"
  },
  "keywords": [
    "kubernetes",
    "devsecops",
    "express",
    "postgresql",
    "redis",
    "prometheus",
    "docker"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PrinceBadru/kubernetes-demo/issues"
  },
  "homepage": "https://github.com/PrinceBadru/kubernetes-demo#readme",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "yaml": "^2.9.1"
  }
}
